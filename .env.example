# Spark
SPARK_MASTER=local[*]
SPARK_APP_NAME=fraud-detection-pipeline

# Delta Lake paths (local or cloud storage)
DELTA_BRONZE_PATH=/data/delta/bronze/transactions
DELTA_SILVER_PATH=/data/delta/silver/transactions
DELTA_GOLD_PATH=/data/delta/gold
RAW_DATA_PATH=/data/raw/transactions

# PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=fraud_analytics
POSTGRES_USER=fraud_user
POSTGRES_PASSWORD=fraud_pass

# Pipeline
BATCH_SIZE=50000
LOG_LEVEL=INFO
ENVIRONMENT=development
